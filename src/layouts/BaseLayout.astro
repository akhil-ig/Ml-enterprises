---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { services } from '../data/services';
import { url } from '../lib/url';

type Props = {
  title: string;
  description: string;
  ogImage?: string;
};

const { title, description, ogImage = 'og-image.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(url(`/${ogImage}`), Astro.site).href;
const fullTitle = title === company.name ? title : `${title} — ${company.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: company.name,
  alternateName: company.shortName,
  slogan: company.tagline,
  url: Astro.site?.href,
  email: company.emails[0],
  telephone: company.phones,
  foundingDate: String(company.establishedYear),
  description: company.intro,
  taxID: company.gstin,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.line1}, ${company.address.line2}`,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    postalCode: company.address.pincode,
    addressCountry: 'IN',
  },
  areaServed: 'India',
  knowsAbout: services.map((s) => s.title),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <meta name="theme-color" content="#e21d26" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal-ready');
        gsap.registerPlugin(ScrollTrigger);

        document.querySelectorAll('[data-reveal]').forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          gsap.to(node, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power3.out',
            delay: Number(node.dataset.revealDelay ?? 0),
            scrollTrigger: { trigger: node, start: 'top 88%', once: true },
          });
        });

        document.querySelectorAll('[data-count]').forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          const target = Number(node.dataset.count);
          const obj = { n: 0 };
          gsap.to(obj, {
            n: target,
            duration: 1.6,
            ease: 'power2.out',
            scrollTrigger: { trigger: node, start: 'top 90%', once: true },
            onUpdate: () => {
              node.textContent = String(Math.round(obj.n));
            },
          });
        });
      }
    </script>
  </body>
</html>
