---
import { url } from '../lib/url';

type Props = {
  eyebrow: string;
  title: string;
  intro?: string;
  image?: string;
};

const { eyebrow, title, intro, image = 'projects/icd-container-yard.webp' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy-900">
  <img
    src={url(`/${image}`)}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-25"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-950 via-navy-900/90 to-navy-900/40"
    aria-hidden="true"
  >
  </div>

  <div class="container-page py-16 md:py-24">
    <p class="eyebrow flex items-center gap-3 text-cyan-brand">
      <span class="inline-block h-[3px] w-8 bg-current"></span>
      {eyebrow}
    </p>
    <h1 class="display-heading mt-4 max-w-4xl text-[2.5rem] text-white sm:text-6xl lg:text-7xl">{title}</h1>
    {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{intro}</p>}
  </div>
</section>
