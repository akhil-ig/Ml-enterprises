---
type Props = {
  eyebrow?: string;
  title: string;
  intro?: string;
  tone?: 'dark' | 'light';
  align?: 'left' | 'center';
};

const { eyebrow, title, intro, tone = 'dark', align = 'left' } = Astro.props;
---

<div data-reveal class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p class:list={['eyebrow flex items-center gap-3 text-brand-red', align === 'center' && 'justify-center']}>
        <span class="inline-block h-[3px] w-7 bg-current" />
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'display-heading mt-4 text-4xl sm:text-5xl lg:text-[3.25rem]',
      tone === 'dark' ? 'text-ink-900' : 'text-white',
    ]}
  >
    {title}
  </h2>
  {
    intro && (
      <p class:list={['mt-5 text-lg leading-relaxed', tone === 'dark' ? 'text-ink-500' : 'text-white/70']}>
        {intro}
      </p>
    )
  }
</div>
