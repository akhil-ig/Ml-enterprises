---
import { company } from '../data/company';
import { services } from '../data/services';
import { url, telHref } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="bg-blueprint-dark bg-ink-950 text-white/65">
  <div class="container-page grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4 lg:py-16">
    <div>
      <img
        src={url('/brand/logo-knockout.png')}
        alt={company.name}
        width="1025"
        height="441"
        class="h-14 w-auto"
        loading="lazy"
      />
      <p class="mt-5 max-w-xs text-sm leading-relaxed">
        Civil works, PEB buildings, railway siding and allied infrastructure — executed end to end across India
        since {company.establishedYear}.
      </p>
      <dl class="mt-5 space-y-1 text-xs text-white/45">
        <div class="flex gap-2"><dt>GSTIN</dt><dd class="text-white/70">{company.gstin}</dd></div>
        <div class="flex gap-2"><dt>Udyam</dt><dd class="text-white/70">{company.udyam}</dd></div>
      </dl>
    </div>

    <div>
      <h2 class="eyebrow text-brand-red">Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          services.map((s) => (
            <li>
              <a href={`${url('/services')}#${s.slug}`} class="transition-colors hover:text-white">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-brand-red">Company</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={url('/about')} class="transition-colors hover:text-white">About &amp; leadership</a></li>
        <li><a href={url('/projects')} class="transition-colors hover:text-white">Projects</a></li>
        <li><a href={url('/gallery')} class="transition-colors hover:text-white">Gallery</a></li>
        <li><a href={url('/clients')} class="transition-colors hover:text-white">Clients</a></li>
        <li><a href={url('/contact')} class="transition-colors hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-brand-red">Get in touch</h2>
      <address class="mt-4 space-y-3 text-sm leading-relaxed not-italic">
        <p>
          {company.address.line1}<br />
          {company.address.line2}<br />
          {company.address.city}, {company.address.state} – {company.address.pincode}
        </p>
        <p>
          {
            company.phones.map((p) => (
              <a href={telHref(p)} class="block transition-colors hover:text-white">
                {p}
              </a>
            ))
          }
        </p>
        <p>
          {
            company.emails.map((e) => (
              <a href={`mailto:${e}`} class="block break-all transition-colors hover:text-white">
                {e}
              </a>
            ))
          }
        </p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {company.name}. All rights reserved.</p>
      <p class="tracking-wide">{company.tagline}</p>
    </div>
  </div>
</footer>
