---
import { url } from '../lib/url';
import type { Partner } from '../data/leadership';

type Props = { partner: Partner; index: number };

const { partner, index } = Astro.props;
---

<article data-reveal data-reveal-delay={index * 0.08} class="border border-sand-200 bg-white">
  <div class="relative aspect-4/3 overflow-hidden bg-sand-100">
    {
      partner.photo ? (
        <img
          src={url(`/team/${partner.photo}`)}
          alt={partner.name}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="bg-blueprint flex h-full w-full flex-col items-center justify-center gap-3 text-ink-400">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
          </svg>
          <p class="eyebrow text-[0.65rem]">Photo awaited</p>
        </div>
      )
    }
  </div>

  <div class="border-t-2 border-brand-red p-6">
    <h3 class="display-heading text-2xl text-ink-900">{partner.name}</h3>
    <p class="mt-1 text-sm font-medium text-brand-red">{partner.role}</p>
    <ul class="mt-4 space-y-2.5">
      {
        partner.responsibilities.map((item) => (
          <li class="flex gap-2.5 text-sm leading-relaxed text-ink-500">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true" />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</article>
