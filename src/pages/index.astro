---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBand from '../components/StatBand.astro';
import CTABand from '../components/CTABand.astro';
import { company, capabilities } from '../data/company';
import { services } from '../data/services';
import { featuredClientNames } from '../data/clients';
import { ongoingProjects } from '../data/projects';
import { url, telHref } from '../lib/url';

const featured = ongoingProjects.slice(0, 3);
const marquee = [...featuredClientNames, ...featuredClientNames];
---

<BaseLayout
  title={company.name}
  description="M L Enterprises LLP — civil construction for railways, roadways, bridges and rail-linked terminals across India. Established 1972, based at Rewari, Haryana."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-navy-900">
    <div class="container-page grid items-center gap-10 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
      <div>
        <p class="eyebrow flex items-center gap-3 text-cyan-brand">
          <span class="inline-block h-[3px] w-8 bg-current"></span>
          Civil construction · Est. {company.establishedYear}
        </p>
        <h1 class="display-heading mt-5 text-[2.5rem] text-white sm:text-6xl lg:text-7xl xl:text-[5.2rem]">
          Building India&rsquo;s <span class="text-cyan-brand">rail</span> &amp; <span class="text-cyan-brand"
            >road</span
          > infrastructure
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">
          {company.intro}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={url('/projects')}
            class="display-heading w-full rounded bg-red-brand px-7 py-4 text-center text-xl tracking-wide text-white transition-colors hover:bg-red-dark sm:w-auto"
          >
            View our projects
          </a>
          <a
            href={telHref(company.phones[0])}
            class="display-heading w-full rounded border-2 border-white/30 px-7 py-4 text-center text-xl tracking-wide text-white transition-colors hover:border-white hover:bg-white/5 sm:w-auto"
          >
            Talk to us
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-3 -z-10 bg-cyan-brand/20 blur-2xl" aria-hidden="true"></div>
        <img
          src={url('/projects/rub-completed.webp')}
          alt="A completed road under bridge built by M L Enterprises, with the railway track running through it"
          width="1067"
          height="716"
          class="w-full border-4 border-white/10 object-cover shadow-2xl"
          fetchpriority="high"
        />
        <div class="absolute -bottom-5 -left-3 bg-red-brand px-5 py-3 sm:-left-5">
          <p class="display-heading text-2xl text-white sm:text-3xl">Concept to commissioning</p>
        </div>
      </div>
    </div>
  </section>

  <StatBand />

  <!-- Client marquee -->
  <section class="overflow-hidden border-b border-concrete-200 bg-white py-8">
    <p class="eyebrow container-page text-concrete-400">Trusted by</p>
    <div class="mt-5 flex w-max marquee-track gap-10 px-5">
      {
        marquee.map((name) => (
          <span class="display-heading shrink-0 text-2xl whitespace-nowrap text-navy-800/70">{name}</span>
        ))
      }
    </div>
  </section>

  <!-- Services -->
  <section class="container-page py-16 lg:py-24">
    <SectionHeading
      eyebrow="What we execute"
      title="From survey to commissioning"
      intro="Seven core capabilities that cover a railway or road package end to end — so a single contractor carries the programme instead of a chain of sub-agencies."
    />

    <div class="mt-12 grid gap-px bg-concrete-200 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <a
            href={`${url('/services')}#${service.slug}`}
            data-reveal
            data-reveal-delay={(i % 3) * 0.08}
            class="group flex flex-col bg-concrete-50 p-7 transition-colors hover:bg-white"
          >
            <span class="display-heading text-5xl text-concrete-200 transition-colors group-hover:text-cyan-brand">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="display-heading mt-4 text-2xl text-navy-900">{service.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-concrete-500">{service.short}</p>
            <span class="eyebrow mt-5 text-red-brand">Read more →</span>
          </a>
        ))
      }
      <div class="flex flex-col justify-center bg-navy-900 p-7 sm:col-span-2 lg:col-span-2">
        <p class="display-heading text-3xl text-white">Need the whole package on EPC?</p>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-white/70">
          We have delivered concept-to-commissioning scopes with our own plant, laboratory and survey teams.
        </p>
        <a href={url('/services')} class="eyebrow mt-5 text-cyan-brand">See all services →</a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-navy-900 py-16 lg:py-24">
    <div class="container-page">
      <SectionHeading
        eyebrow="Why M L Enterprises"
        title="Capability we own, not capability we hire"
        intro="Five decades of railway work has left us with the plant, the laboratory and the people to hold a programme date."
        tone="light"
      />

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          capabilities.map((cap, i) => (
            <div data-reveal data-reveal-delay={(i % 3) * 0.08} class="border-t-2 border-cyan-brand/40 pt-5">
              <h3 class="display-heading text-2xl text-white">{cap.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/65">{cap.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured ongoing work -->
  <section class="container-page py-16 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Currently on site"
        title="Work in hand"
        intro="Nine packages are under execution right now for logistics, PSU and corporate clients."
      />
      <a
        href={url('/projects')}
        data-reveal
        class="display-heading rounded border-2 border-navy-900 px-6 py-3 text-lg tracking-wide text-navy-900 transition-colors hover:bg-navy-900 hover:text-white"
      >
        All 52 projects
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        featured.map((project, i) => (
          <article
            data-reveal
            data-reveal-delay={i * 0.08}
            class="flex flex-col border border-concrete-200 bg-white p-6"
          >
            <span class="eyebrow text-red-brand">In progress</span>
            <h3 class="mt-3 flex-1 text-base leading-relaxed font-semibold text-navy-900">{project.title}</h3>
            <dl class="mt-5 space-y-1 border-t border-concrete-200 pt-4 text-sm">
              <div class="flex gap-2">
                <dt class="text-concrete-400">Client</dt>
                <dd class="font-medium text-navy-800">{project.client}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="text-concrete-400">Location</dt>
                <dd class="font-medium text-navy-800">
                  {project.location}, {project.state}
                </dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>
