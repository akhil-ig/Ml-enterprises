---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABand from '../components/CTABand.astro';
import { clients, clientSectors, keyClientNames } from '../data/clients';
import { projects } from '../data/projects';

const projectsFor = (name: string) => projects.filter((p) => p.client === name).length;
---

<BaseLayout
  title="Clients"
  description="M L Enterprises LLP executes for the Adani Group, DP World, UltraTech Cement, Pristine Mega Logistics Park, Kanpur Logistics Park, RVNL, IRCON and HURL."
>
  <PageHero
    eyebrow="Clients"
    title="Who we build for"
    intro="Logistics majors, government PSUs and industrial groups — with repeat packages awarded across multiple sites."
    image="gallery/team-project-group.webp"
  />

  <!-- Key clients -->
  <section class="bg-blueprint bg-sand-50 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Key clients" title="The names on our work orders" />
      <ul class="mt-10 grid gap-px bg-sand-200 sm:grid-cols-2 lg:grid-cols-5">
        {
          keyClientNames.map((name, i) => (
            <li
              data-reveal
              data-reveal-delay={(i % 5) * 0.06}
              class="flex min-h-32 items-center justify-center bg-white p-6 text-center"
            >
              <span class="display-heading text-xl text-ink-900">{name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- By sector -->
  <section class="container-page py-16 lg:py-20">
    {
      clientSectors.map((sector, si) => (
        <div class:list={[si > 0 && 'mt-14']}>
          <SectionHeading eyebrow={`0${si + 1}`} title={sector} />

          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {clients
              .filter((c) => c.sector === sector)
              .map((client, i) => {
                const n = projectsFor(client.name);
                return (
                  <li data-reveal data-reveal-delay={(i % 3) * 0.06} class="border border-sand-200 bg-white p-6">
                    {client.short && <p class="display-heading text-2xl text-brand-red">{client.short}</p>}
                    <p
                      class:list={[
                        'text-ink-900',
                        client.short ? 'mt-1 text-sm text-ink-500' : 'display-heading text-xl',
                      ]}
                    >
                      {client.name}
                    </p>
                    {n > 0 && (
                      <p class="mt-4 border-t border-sand-200 pt-3 text-xs tracking-wide text-ink-400 uppercase">
                        {n} project{n === 1 ? '' : 's'} in our record
                      </p>
                    )}
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="bg-ink-900 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="References"
        title="Work orders and completion certificates on request"
        intro="Every package in our record is backed by the awarding authority's work order and, where the work is closed, a completion certificate. We are happy to share these for any project relevant to your tender."
        tone="light"
      />
    </div>
  </section>

  <CTABand />
</BaseLayout>
