---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABand from '../components/CTABand.astro';
import { services } from '../data/services';
import { projects } from '../data/projects';

const countFor = (slug: string) => projects.filter((p) => p.category === slug).length;
---

<BaseLayout
  title="Services"
  description="Survey and alignment design, earthwork, ballast supply, P-Way laying and linking, rail and road bridges, rail-linked terminals and annual maintenance of rail infrastructure."
>
  <PageHero
    eyebrow="Services"
    title="What we execute"
    intro="Seven core capabilities covering a railway or road package from the first survey peg to the commissioned asset."
    image="projects/icd-container-yard.webp"
  />

  <!-- Quick index -->
  <section class="border-b border-concrete-200 bg-white">
    <div class="container-page flex flex-wrap gap-2 py-6">
      {
        services.map((s) => (
          <a
            href={`#${s.slug}`}
            class="display-heading border border-concrete-200 px-4 py-2 text-lg text-navy-800 transition-colors hover:border-navy-900 hover:bg-navy-900 hover:text-white"
          >
            {s.title}
          </a>
        ))
      }
    </div>
  </section>

  <div class="container-page py-16 lg:py-24">
    <div class="space-y-16 lg:space-y-24">
      {
        services.map((service, i) => (
          <section id={service.slug} class="scroll-mt-28">
            <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
              <div data-reveal>
                <p class="display-heading text-7xl text-concrete-200">{String(i + 1).padStart(2, '0')}</p>
                <h2 class="display-heading mt-2 text-4xl text-navy-900 sm:text-5xl">{service.title}</h2>
                {countFor(service.slug) > 0 && (
                  <p class="mt-4 text-sm text-concrete-400">
                    {countFor(service.slug)} project{countFor(service.slug) === 1 ? '' : 's'} in our record under this
                    head
                  </p>
                )}
              </div>

              <div data-reveal data-reveal-delay="0.1">
                <p class="text-lg leading-relaxed text-concrete-500">{service.body}</p>
                <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                  {service.points.map((point) => (
                    <li class="flex gap-3 border-t border-concrete-200 pt-3 text-sm leading-relaxed text-navy-800">
                      <span class="mt-1.5 h-2 w-2 shrink-0 bg-red-brand" aria-hidden="true" />
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section class="bg-navy-900 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Single responsibility"
        title="Or hand us the whole package on EPC"
        intro="We have taken scopes from concept to commissioning, including allied infrastructure — with our own plant and machinery, material investigation laboratory, survey teams and trained manpower behind the programme."
        tone="light"
      />
    </div>
  </section>

  <CTABand />
</BaseLayout>
