---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTABand from '../components/CTABand.astro';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { url } from '../lib/url';

const countFor = (slug: string) => projects.filter((p) => p.category === slug).length;
---

<BaseLayout
  title="Services"
  description="Civil and building works, railway siding projects, overhead electrification, railway yard development, P-Way works, pre-engineered buildings, fire fighting systems and electrical works."
>
  <PageHero
    eyebrow="Services"
    title="What we execute"
    intro="Eight disciplines covering a railway siding or industrial package from foundation to commissioning."
    image="gallery/civil-excavation-formwork.webp"
  />

  <section class="border-b border-sand-200 bg-white">
    <div class="container-page flex flex-wrap gap-2 py-6">
      {
        services.map((s) => (
          <a
            href={`#${s.slug}`}
            class="display-heading border border-sand-200 px-4 py-2 text-lg text-ink-800 transition-colors hover:border-brand-red hover:bg-brand-red hover:text-white"
          >
            {s.title}
          </a>
        ))
      }
    </div>
  </section>

  <div class="container-page py-16 lg:py-20">
    <div class="space-y-16 lg:space-y-20">
      {
        services.map((service, i) => (
          <section id={service.slug} class="scroll-mt-28">
            <div class:list={['grid items-start gap-10 lg:grid-cols-2']}>
              <div data-reveal class:list={[i % 2 === 1 && 'lg:order-2']}>
                <img
                  src={url(`/${service.image}`)}
                  alt={service.title}
                  class="aspect-4/3 w-full object-cover"
                  loading="lazy"
                />
              </div>

              <div data-reveal data-reveal-delay="0.08">
                <p class="display-heading text-5xl text-sand-300">{String(i + 1).padStart(2, '0')}</p>
                <h2 class="display-heading mt-2 text-3xl text-ink-900 sm:text-4xl">{service.title}</h2>
                {countFor(service.slug) > 0 && (
                  <p class="mt-3 text-sm text-ink-400">
                    {countFor(service.slug)} project{countFor(service.slug) === 1 ? '' : 's'} in our record under this
                    head
                  </p>
                )}
                <p class="mt-5 text-lg leading-relaxed text-ink-500">{service.body}</p>
                <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                  {service.points.map((point) => (
                    <li class="flex gap-3 border-t border-sand-200 pt-3 text-sm leading-relaxed text-ink-700">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true" />
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <section class="bg-blueprint-dark bg-ink-900 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Single responsibility"
        title="Or hand us the whole package"
        intro="Civil, PEB, railway, P-Way, OHE, electrical and fire fighting under one contract — with partners who own each discipline and stay involved on site through to handover."
        tone="light"
      />
    </div>
  </section>

  <CTABand />
</BaseLayout>
