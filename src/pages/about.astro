---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBand from '../components/StatBand.astro';
import CTABand from '../components/CTABand.astro';
import PartnerCard from '../components/PartnerCard.astro';
import { company, aboutParagraphs, vision, mission, policies, strengths } from '../data/company';
import { partners, leadershipIntro } from '../data/leadership';
import { projectStates } from '../data/projects';
import { url } from '../lib/url';

const milestones = [
  { year: '2008', title: 'Founded as M L Enterprises', body: 'The firm begins with civil, railway and siding projects out of Rewari, Haryana.' },
  { year: '2016', title: 'Mainline railway construction', body: 'Roadbed, bridges, RUBs, ROBs and track linking on the new Barbigha–Sheikhpura line for Rail Vikas Nigam Ltd.' },
  { year: '2020', title: 'Restructured as an LLP', body: 'New partners are inducted and the firm is restructured as M L Enterprises LLP, broadening capability across electrical, OHE and FFS.' },
  { year: '2022', title: 'Silo and terminal programmes', body: 'Grain silo and rail-linked terminal packages delivered for Adani Agri Logistics across Bihar, Haryana and Punjab.' },
  { year: '2025', title: 'PEB and multi-discipline scopes', body: 'Custom building, PEB warehouse, paved yard, electrical and fire fighting package awarded by DP World at Panipat.' },
  { year: 'Today', title: 'Six packages in hand', body: 'Active sites for Adani, DP World and UltraTech Cement across Madhya Pradesh, Maharashtra, Haryana, Gujarat and Uttar Pradesh.' },
];
---

<BaseLayout
  title="About us"
  description="M L Enterprises LLP — established 2008, restructured as an LLP in 2020. Civil works, PEB buildings, railway siding, OHE, electrical and fire fighting systems, led by three working partners."
>
  <PageHero
    eyebrow="About us"
    title="Construct for future"
    intro="A professionally managed civil infrastructure contracting firm, led by partners who stay on the site."
    image="gallery/silo-complex-construction.webp"
  />

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div data-reveal>
        <SectionHeading eyebrow="Who we are" title="Built on execution, not promises" />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-500">
          {aboutParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.1" class="space-y-6">
        <img
          src={url('/gallery/team-project-group.webp')}
          alt="The project team assembled at a completed facility"
          class="w-full object-cover"
          loading="lazy"
        />
        <dl class="grid grid-cols-2 gap-px bg-sand-200 text-sm">
          <div class="bg-white p-5">
            <dt class="eyebrow text-ink-400">GSTIN</dt>
            <dd class="mt-1 font-semibold text-ink-900">{company.gstin}</dd>
          </div>
          <div class="bg-white p-5">
            <dt class="eyebrow text-ink-400">Udyam Reg.</dt>
            <dd class="mt-1 font-semibold text-ink-900">{company.udyam}</dd>
          </div>
          <div class="col-span-2 bg-white p-5">
            <dt class="eyebrow text-ink-400">Registered office</dt>
            <dd class="mt-1 leading-relaxed text-ink-900">
              {company.address.line1}, {company.address.line2}, {company.address.city}, {company.address.state} – {
                company.address.pincode
              }
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <StatBand />

  <!-- Vision & mission -->
  <section class="bg-blueprint bg-sand-50 py-16 lg:py-20">
    <div class="container-page grid gap-12 lg:grid-cols-2">
      <div data-reveal class="border-l-4 border-brand-red bg-white p-8 lg:p-10">
        <p class="eyebrow text-brand-red">Vision</p>
        <p class="mt-5 text-2xl leading-snug font-medium text-ink-900 lg:text-3xl">{vision}</p>
      </div>

      <div data-reveal data-reveal-delay="0.1" class="bg-white p-8 lg:p-10">
        <p class="eyebrow text-brand-red">Mission</p>
        <ul class="mt-6 space-y-4">
          {
            mission.map((item, i) => (
              <li class="flex gap-4 border-b border-sand-100 pb-4 last:border-0">
                <span class="display-heading text-2xl text-sand-300">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-base leading-relaxed text-ink-700">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="container-page py-16 lg:py-20">
    <SectionHeading eyebrow="Leadership" title="The partners" intro={leadershipIntro} />
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {partners.map((partner, i) => <PartnerCard partner={partner} index={i} />)}
    </div>
  </section>

  <!-- Organisation chart -->
  <section class="bg-ink-900 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="How we are organised"
        title="Organisation structure"
        intro="Partners at the top, a project director driving delivery, and separate heads for engineering, HSE and QA/QC so quality and safety never report into production."
        tone="light"
      />
      <div data-reveal class="mt-10 bg-white p-4 lg:p-6">
        <img
          src={url('/brand/org-chart.webp')}
          alt="Organisation chart: partners and managing partners, then project director, then HR and administration, planning and billing, engineering head for civil, P-Way and OHE, and HSE with QA/QC head, leading down to supervisors and workforce"
          width="1536"
          height="733"
          class="w-full"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Policies -->
  <section class="container-page py-16 lg:py-20">
    <SectionHeading eyebrow="Policies" title="Safety and quality, in writing" />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        policies.map((policy, i) => (
          <div data-reveal data-reveal-delay={i * 0.08} class="border-t-2 border-brand-red bg-sand-50 p-8">
            <h3 class="display-heading text-2xl text-ink-900">{policy.title}</h3>
            <p class="mt-4 leading-relaxed text-ink-500">{policy.body}</p>
            <ul class="mt-6 space-y-2.5">
              {policy.points.map((point) => (
                <li class="flex gap-2.5 text-sm text-ink-700">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true" />
                  {point}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Strengths -->
  <section class="bg-sand-50 py-16 lg:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Why us" title="What we bring to a package" />
      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          strengths.map((item, i) => (
            <div data-reveal data-reveal-delay={(i % 3) * 0.08} class="border-t border-sand-300 pt-5">
              <h3 class="display-heading text-xl text-ink-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="container-page py-16 lg:py-20">
    <SectionHeading eyebrow="Track record" title="How the work grew" />
    <ol class="mt-12 grid gap-px bg-sand-200 md:grid-cols-2 lg:grid-cols-3">
      {
        milestones.map((m, i) => (
          <li data-reveal data-reveal-delay={(i % 3) * 0.08} class="bg-white p-7">
            <p class="display-heading text-4xl text-brand-red">{m.year}</p>
            <h3 class="display-heading mt-3 text-xl text-ink-900">{m.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{m.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Presence -->
  <section class="container-page pb-16 lg:pb-20">
    <SectionHeading
      eyebrow="Where we work"
      title="PAN India execution"
      intro="Packages delivered from Haryana and Punjab through to Bihar, Maharashtra, Madhya Pradesh, Telangana and Gujarat."
    />
    <ul class="mt-10 flex flex-wrap gap-3">
      {
        projectStates.map((state, i) => (
          <li
            data-reveal
            data-reveal-delay={(i % 6) * 0.05}
            class="display-heading border border-sand-200 bg-sand-50 px-5 py-3 text-xl text-ink-800"
          >
            {state}
          </li>
        ))
      }
    </ul>
  </section>

  <CTABand />
</BaseLayout>
