---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatBand from '../components/StatBand.astro';
import CTABand from '../components/CTABand.astro';
import { company, aboutParagraphs, competenceParagraph, capabilities } from '../data/company';
import { projectStates } from '../data/projects';
import { url } from '../lib/url';

const milestones = [
  {
    year: '1972',
    title: 'Founded as M/s. Sis Ram Bir Singh',
    body: 'The firm begins civil contracting out of Rewari, Haryana.',
  },
  {
    year: '2008',
    title: 'Mainline railway work',
    body: 'Ballast supply for the Rewari–Harsauli broad gauge doubling project with North Western Railway.',
  },
  {
    year: '2011–2015',
    title: 'Rail-linked terminals',
    body: 'Terminal, siding and paved yard packages for Kribhco, Sanjvik, Pristine and Gateway across Haryana, Punjab, UP and Bihar.',
  },
  {
    year: '2016',
    title: 'New line construction',
    body: 'Roadbed, bridges, RUBs, ROBs and track linking on the 16.8 km Barbigha–Sheikhpura new line for RVNL.',
  },
  {
    year: '2019–2022',
    title: 'PSU and corporate scale',
    body: 'Loco shed track work for IRCON, fertilizer complex siding for HURL, and the MMLP package for CONCOR at Kadakola.',
  },
  {
    year: 'Today',
    title: 'Operating as M L Enterprises LLP',
    body: 'Nine packages in hand across four states, with ballast supply on the Haryana Orbital Rail Corridor.',
  },
];
---

<BaseLayout
  title="About us"
  description="M L Enterprises LLP, formerly M/s. Sis Ram Bir Singh, established 1972 at Rewari, Haryana — civil construction for railways, roadways, bridges and buildings across PAN India."
>
  <PageHero
    eyebrow="About us"
    title="Five decades of civil construction"
    intro="Established in 1972 at Rewari, Haryana. Today an LLP executing railway and road infrastructure across PAN India."
    image="projects/box-culvert-construction.webp"
  />

  <section class="container-page py-16 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div data-reveal>
        <SectionHeading eyebrow="Our commitment" title="Built on mutual trust" />
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-concrete-500">
          {aboutParagraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.1">
        <img
          src={url('/projects/rub-under-construction.webp')}
          alt="RUB construction alongside a live railway line, with reinforcement work in progress"
          width="800"
          height="448"
          class="w-full object-cover"
          loading="lazy"
        />
        <div class="mt-6 border-l-4 border-red-brand bg-white p-6">
          <p class="eyebrow text-concrete-400">Registered office</p>
          <p class="mt-2 leading-relaxed text-navy-900">
            {company.address.line1}<br />
            {company.address.line2}<br />
            {company.address.city}, {company.address.state} – {company.address.pincode}
          </p>
        </div>
      </div>
    </div>
  </section>

  <StatBand />

  <!-- Competence -->
  <section class="container-page py-16 lg:py-24">
    <SectionHeading
      eyebrow="Competence"
      title="Twenty years with India's largest infrastructure names"
    />
    <p data-reveal class="mt-8 max-w-4xl text-lg leading-relaxed text-concrete-500">{competenceParagraph}</p>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map((cap, i) => (
          <div data-reveal data-reveal-delay={(i % 3) * 0.08} class="border-t-2 border-red-brand/30 pt-5">
            <h3 class="display-heading text-2xl text-navy-900">{cap.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-concrete-500">{cap.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Timeline -->
  <section class="bg-navy-900 py-16 lg:py-24">
    <div class="container-page">
      <SectionHeading eyebrow="Our track record" title="How the work grew" tone="light" />

      <ol class="mt-12 grid gap-px bg-white/10 md:grid-cols-2 lg:grid-cols-3">
        {
          milestones.map((m, i) => (
            <li data-reveal data-reveal-delay={(i % 3) * 0.08} class="bg-navy-900 p-7">
              <p class="display-heading text-4xl text-cyan-brand">{m.year}</p>
              <h3 class="display-heading mt-3 text-xl text-white">{m.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{m.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Presence -->
  <section class="container-page py-16 lg:py-24">
    <SectionHeading
      eyebrow="Where we work"
      title="PAN India execution"
      intro="Packages delivered from Haryana and Punjab through to Bihar, Maharashtra, Chhattisgarh and Karnataka."
    />
    <ul class="mt-10 flex flex-wrap gap-3">
      {
        projectStates.map((state, i) => (
          <li
            data-reveal
            data-reveal-delay={(i % 6) * 0.05}
            class="display-heading border border-concrete-200 bg-white px-5 py-3 text-xl text-navy-800"
          >
            {state}
          </li>
        ))
      }
    </ul>
  </section>

  <CTABand />
</BaseLayout>
