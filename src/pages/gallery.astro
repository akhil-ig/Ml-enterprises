---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { gallery, galleryCategories } from '../data/gallery';
import { url } from '../lib/url';

const countFor = (category: string) => gallery.filter((g) => g.category === category).length;
---

<BaseLayout
  title="Gallery"
  description="Photographs from M L Enterprises LLP sites — railway and P-Way works, civil structures, PEB warehouses, paved yards, silo complexes, fire fighting installations and site teams."
>
  <PageHero
    eyebrow="Gallery"
    title="Glimpses of our sites"
    intro="Work in progress and completed facilities across our railway, civil, PEB and yard packages."
    image="gallery/peb-warehouse-exterior.webp"
  />

  <section class="container-page py-12 lg:py-16">
    <div class="sticky top-[4.5rem] z-30 -mx-5 border-b border-sand-200 bg-white/95 px-5 py-4 backdrop-blur">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter photographs by category">
        <button
          type="button"
          data-gallery-filter="all"
          aria-pressed="true"
          class="display-heading border border-sand-200 px-4 py-2 text-lg text-ink-800 transition-colors aria-pressed:border-brand-red aria-pressed:bg-brand-red aria-pressed:text-white"
        >
          All ({gallery.length})
        </button>
        {
          galleryCategories.map((category) => (
            <button
              type="button"
              data-gallery-filter={category}
              aria-pressed="false"
              class="display-heading border border-sand-200 px-4 py-2 text-lg text-ink-800 transition-colors aria-pressed:border-brand-red aria-pressed:bg-brand-red aria-pressed:text-white"
            >
              {category} ({countFor(category)})
            </button>
          ))
        }
      </div>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        gallery.map((item, i) => (
          <li class="gallery-item" data-category={item.category}>
            <figure data-reveal data-reveal-delay={(i % 3) * 0.06} class="group h-full border border-sand-200 bg-white">
              <div class="aspect-4/3 overflow-hidden bg-sand-100">
                <img
                  src={url(`/gallery/${item.file}`)}
                  alt={item.alt}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <figcaption class="flex items-start justify-between gap-3 p-4">
                <p class="text-sm leading-relaxed text-ink-700">{item.alt}</p>
                <span class="eyebrow shrink-0 text-[0.6rem] text-ink-400">{item.category}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <p id="gallery-empty" class="hidden py-16 text-center text-lg text-ink-400">
      No photographs in this category yet.
    </p>
  </section>

  <CTABand
    title="More site photographs and videos are on the way"
    body="We are adding further documentation from our current packages. For project-specific photographs or a credentials pack, get in touch."
  />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll('[data-gallery-filter]'));
  const items = Array.from(document.querySelectorAll('.gallery-item'));
  const empty = document.getElementById('gallery-empty');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLElement)) return;
      const value = button.dataset.galleryFilter ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

      let visible = 0;
      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        const match = value === 'all' || item.dataset.category === value;
        item.hidden = !match;
        if (match) visible += 1;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
